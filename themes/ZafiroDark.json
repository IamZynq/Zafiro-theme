    "editorMarkerNavigation.background": "#220f13",
    "peekView.border": "#ff4d6d",
    "peekViewEditor.background": "#150a0c",
    "peekViewEditor.matchHighlightBackground": "#ffb45440",
    "peekViewResult.background": "#220f13",
    "peekViewResult.matchHighlightBackground": "#ffb45440",
    "peekViewTitle.background": "#220f13",
    "peekViewTitleLabel.foreground": "#f2e5e7",
    "peekViewTitleDescription.foreground": "#f2e5e799",

    "activityBar.background": "#1a0e10",
    "activityBar.foreground": "#f2e5e7",
    "activityBar.inactiveForeground": "#6b3f47",
    "activityBar.border": "#150a0c",
    "activityBarBadge.background": "#ff4d6d",
    "activityBarBadge.foreground": "#1a0e10",

    "sideBar.background": "#150a0c",
    "sideBar.foreground": "#e0c7cb",
    "sideBar.border": "#150a0c",
    "sideBarTitle.foreground": "#f2e5e7",
    "sideBarSectionHeader.background": "#1a0e10",
    "sideBarSectionHeader.border": "#150a0c",

    "list.activeSelectionBackground": "#3d1f24",
    "list.activeSelectionForeground": "#ffffff",
    "list.inactiveSelectionBackground": "#3d1f2480",
    "list.hoverBackground": "#3d1f2460",
    "list.dropBackground": "#3d1f24",
    "list.highlightForeground": "#ff4d6d",
    "list.focusBackground": "#3d1f24",
    "listFilterWidget.background": "#3d1f24",
    "listFilterWidget.outline": "#ff4d6d",
    "listFilterWidget.noMatchesOutline": "#ff2e4d",
    "tree.indentGuidesStroke": "#3d1f24",

    "statusBar.background": "#ff4d6d",
    "statusBar.foreground": "#1a0e10",
    "statusBar.border": "#150a0c",
    "statusBar.debuggingBackground": "#c77dff",
    "statusBar.debuggingForeground": "#1a0e10",
    "statusBar.noFolderBackground": "#8a3646",
    "statusBarItem.hoverBackground": "#ff8fa3",
    "statusBarItem.remoteBackground": "#4ea8de",
    "statusBarItem.remoteForeground": "#1a0e10",

    "titleBar.activeBackground": "#1a0e10",
    "titleBar.activeForeground": "#f2e5e7",
    "titleBar.inactiveBackground": "#1a0e10",
    "titleBar.inactiveForeground": "#6b3f47",
    "titleBar.border": "#150a0c",

    "menu.background": "#220f13",
    "menu.foreground": "#f2e5e7",
    "menu.selectionBackground": "#3d1f24",
    "menu.selectionForeground": "#ffffff",
    "menu.separatorBackground": "#3d1f24",
    "menubar.selectionBackground": "#3d1f24",
    "menubar.selectionForeground": "#ffffff",

    "tab.activeBackground": "#1a0e10",
    "tab.activeForeground": "#ffffff",
    "tab.inactiveBackground": "#150a0c",
    "tab.inactiveForeground": "#8a636f",
    "tab.border": "#150a0c",
    "tab.activeBorder": "#ff4d6d",
    "tab.unfocusedActiveBorder": "#8a3646",
    "editorGroup.border": "#150a0c",
    "editorGroupHeader.tabsBackground": "#150a0c",
    "editorGroupHeader.tabsBorder": "#150a0c",

    "panel.background": "#150a0c",
    "panel.border": "#ff4d6d",
    "panelTitle.activeBorder": "#ff4d6d",
    "panelTitle.activeForeground": "#ffffff",
    "panelTitle.inactiveForeground": "#8a636f",

    "terminal.background": "#1a0e10",
    "terminal.foreground": "#f2e5e7",
    "terminal.ansiBlack": "#2a1418",
    "terminal.ansiRed": "#ff2e4d",
    "terminal.ansiGreen": "#7ee087",
    "terminal.ansiYellow": "#ffd166",
    "terminal.ansiBlue": "#4ea8de",
    "terminal.ansiMagenta": "#c77dff",
    "terminal.ansiCyan": "#56e0c4",
    "terminal.ansiWhite": "#f2e5e7",
    "terminal.ansiBrightBlack": "#6b3f47",
    "terminal.ansiBrightRed": "#ff4d6d",
    "terminal.ansiBrightGreen": "#a8e6a3",
    "terminal.ansiBrightYellow": "#ffe29a",
    "terminal.ansiBrightBlue": "#64c9ff",
    "terminal.ansiBrightMagenta": "#e0aaff",
    "terminal.ansiBrightCyan": "#8ff0d6",
    "terminal.ansiBrightWhite": "#ffffff",

    "input.background": "#150a0c",
    "input.foreground": "#f2e5e7",
    "input.border": "#8a3646",
    "input.placeholderForeground": "#8a636f",
    "inputOption.activeBorder": "#ff4d6d",
    "inputValidation.errorBackground": "#ff2e4d30",
    "inputValidation.errorBorder": "#ff2e4d",
    "inputValidation.infoBackground": "#4ea8de30",
    "inputValidation.infoBorder": "#4ea8de",
    "inputValidation.warningBackground": "#ffd16630",
    "inputValidation.warningBorder": "#ffd166",

    "dropdown.background": "#220f13",
    "dropdown.foreground": "#f2e5e7",
    "dropdown.border": "#8a3646",

    "button.background": "#ff4d6d",
    "button.foreground": "#1a0e10",
    "button.hoverBackground": "#ff6b84",
    "button.secondaryBackground": "#3d1f24",
    "button.secondaryForeground": "#f2e5e7",
    "button.secondaryHoverBackground": "#57272e",

    "badge.background": "#ff4d6d",
    "badge.foreground": "#1a0e10",

    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.background": "#ff4d6d30",
    "scrollbarSlider.hoverBackground": "#ff4d6d50",
    "scrollbarSlider.activeBackground": "#ff4d6d80",

    "progressBar.background": "#ff4d6d",

    "breadcrumb.foreground": "#8a636f",
    "breadcrumb.focusForeground": "#f2e5e7",
    "breadcrumb.activeSelectionForeground": "#ff4d6d",
    "breadcrumbPicker.background": "#220f13",

    "extensionButton.prominentBackground": "#ff4d6d",
    "extensionButton.prominentForeground": "#1a0e10",
    "extensionButton.prominentHoverBackground": "#ff6b84",

    "gitDecoration.addedResourceForeground": "#7ee087",
    "gitDecoration.modifiedResourceForeground": "#ffd166",
    "gitDecoration.deletedResourceForeground": "#ff2e4d",
    "gitDecoration.untrackedResourceForeground": "#7ee087",
    "gitDecoration.ignoredResourceForeground": "#6b3f47",
    "gitDecoration.conflictingResourceForeground": "#c77dff",

    "diffEditor.insertedTextBackground": "#7ee08730",
    "diffEditor.removedTextBackground": "#ff2e4d30",
    "diffEditor.diagonalFill": "#3d1f24",

    "notificationCenterHeader.background": "#220f13",
    "notifications.background": "#220f13",
    "notifications.foreground": "#f2e5e7",
    "notifications.border": "#8a3646",
    "notificationsErrorIcon.foreground": "#ff2e4d",
    "notificationsWarningIcon.foreground": "#ffd166",
    "notificationsInfoIcon.foreground": "#4ea8de",

    "debugToolBar.background": "#220f13",
    "debugIcon.breakpointForeground": "#ff2e4d",

    "welcomePage.buttonBackground": "#3d1f24",
    "welcomePage.buttonHoverBackground": "#57272e"
  },
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "keyword": { "foreground": "#ff4d6d", "bold": true },
    "keyword.control": { "foreground": "#ff2e4d", "bold": true },
    "keyword.async": { "foreground": "#ff4d6d", "italic": true },
    "storage": { "foreground": "#ff4d6d" },
    "modifier": { "foreground": "#ff8fa3", "italic": true },
    "function": { "foreground": "#4ea8de" },
    "function.declaration": { "foreground": "#4ea8de", "bold": true },
    "function.defaultLibrary": { "foreground": "#56e0c4" },
    "method": { "foreground": "#4ea8de" },
    "method.declaration": { "foreground": "#4ea8de", "bold": true },
    "macro": { "foreground": "#56e0c4" },
    "class": { "foreground": "#ffd166", "bold": true },
    "class.declaration": { "foreground": "#ffd166", "bold": true },
    "interface": { "foreground": "#ffe29a", "italic": true },
    "enum": { "foreground": "#ffd166" },
    "enumMember": { "foreground": "#ffb454" },
    "struct": { "foreground": "#ffd166" },
    "type": { "foreground": "#ffd166" },
    "type.defaultLibrary": { "foreground": "#56e0c4" },
    "typeParameter": { "foreground": "#ffd166", "italic": true },
    "namespace": { "foreground": "#ffd166", "italic": true },
    "parameter": { "foreground": "#e0aaff", "italic": true },
    "variable": { "foreground": "#f2e5e7" },
    "variable.readonly": { "foreground": "#ffb454" },
    "variable.defaultLibrary": { "foreground": "#f2e5e7", "italic": true },
    "property": { "foreground": "#ff8fa3" },
    "property.readonly": { "foreground": "#ffb454" },
    "decorator": { "foreground": "#ffd166", "italic": true },
    "number": { "foreground": "#ffb454" },
    "string": { "foreground": "#a8e6a3" },
    "comment": { "foreground": "#8a636f", "italic": true },
    "operator": { "foreground": "#c77dff" },
    "label": { "foreground": "#ff4d6d" },
    "selfParameter": { "foreground": "#e0aaff", "italic": true, "bold": true },
    "boolean": { "foreground": "#ffb454" }
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#8a636f", "fontStyle": "italic" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "string constant.other.placeholder", "support.variable"],
      "settings": { "foreground": "#f2e5e7" }
    },
    {
      "name": "Variables - readonly / constant case",
      "scope": [
        "variable.other.constant",
        "variable.other.readwrite.alias",
        "meta.definition.variable variable.other.constant"
      ],
      "settings": { "foreground": "#ffb454", "fontStyle": "bold" }
    },
    {
      "name": "Function Parameters",
      "scope": ["variable.parameter", "meta.parameter", "variable.parameter.function"],
      "settings": { "foreground": "#e0aaff", "fontStyle": "italic" }
    },
    {
      "name": "Properties",
      "scope": ["variable.other.property", "variable.other.object.property", "meta.object-literal.key"],
      "settings": { "foreground": "#ff8fa3" }
    },
    {
      "name": "Colors",
      "scope": ["constant.other.color"],
      "settings": { "foreground": "#56e0c4" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#1a0e10", "background": "#ff2e4d" }
    },
    {
      "name": "Reserved words / Keywords (general)",
      "scope": ["keyword", "keyword.other"],
      "settings": { "foreground": "#ff4d6d", "fontStyle": "bold" }
    },
    {
      "name": "Reserved words - control flow (if/else/for/while/return/switch/etc.)",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.trycatch",
        "keyword.control.switch",
        "keyword.control.return",
        "keyword.control.new",
        "keyword.control.flow.jump"
      ],
      "settings": { "foreground": "#ff2e4d", "fontStyle": "bold" }
    },
    {
      "name": "Reserved words - module (import/export/from/package/use)",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.module",
        "keyword.other.import",
        "keyword.package.go",
        "keyword.import.go",
        "keyword.other.using"
      ],
      "settings": { "foreground": "#ff4d6d" }
    },
    {
      "name": "Storage - type declarations (class/function/interface/struct/enum)",
      "scope": [
        "storage.type",
        "storage.type.function",
        "storage.type.class",
        "storage.type.interface",
        "storage.type.enum",
        "storage.type.struct",
        "storage.type.namespace"
      ],
      "settings": { "foreground": "#ff4d6d", "fontStyle": "bold" }
    },
    {
      "name": "Storage - modifiers (static/public/private/const/async/etc.)",
      "scope": [
        "storage.modifier",
        "storage.modifier.async",
        "storage.modifier.static",
        "storage.modifier.access-control",
        "keyword.modifier"
      ],
      "settings": { "foreground": "#ff8fa3", "fontStyle": "italic" }
    },
    {
      "name": "Storage type as const/let/var",
      "scope": ["storage.type.const", "storage.type.let", "storage.type.var"],
      "settings": { "foreground": "#ff4d6d" }
    },
    {
      "name": "Primitive / built-in types (int, char, float, bool, void, etc.)",
      "scope": [
        "storage.type.primitive",
        "storage.type.primitive.c",
        "storage.type.primitive.cpp",
        "storage.type.built-in",
        "storage.type.built-in.primitive",
        "storage.type.built-in.primitive.c",
        "storage.type.built-in.primitive.cpp",
        "support.type.primitive",
        "support.type.built-in",
        "keyword.type.go",
        "storage.type.numeric.go",
        "storage.type.built-in.rust",
        "storage.type.primitive.java",
        "storage.type.built-in.cs",
        "storage.type.built-in.primitive.cs"
      ],
      "settings": { "foreground": "#56e0c4" }
    },
    {
      "name": "Language constants (true/false/null/nil/undefined/self/this)",
      "scope": [
        "constant.language",
        "variable.language",
        "constant.language.boolean",
        "support.constant.property-value"
      ],
      "settings": { "foreground": "#ffb454", "fontStyle": "italic bold" }
    },
    {
      "name": "Operator, Punctuation",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.logical",
        "keyword.operator.comparison",
        "punctuation",
        "meta.tag",
        "punctuation.definition.tag",
        "punctuation.separator.inheritance.php",
        "punctuation.definition.tag.html",
        "punctuation.definition.tag.begin.html",
        "punctuation.definition.tag.end.html",
        "punctuation.section.embedded",
        "keyword.other.template",
        "keyword.other.substitution"
      ],
      "settings": { "foreground": "#c77dff" }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag", "meta.tag.sgml", "markup.deleted.git_gutter"],
      "settings": { "foreground": "#ff4d6d", "fontStyle": "bold" }
    },
    {
      "name": "Function / Method declarations",
      "scope": [
        "entity.name.function",
        "meta.function.method",
        "meta.definition.function entity.name.function"
      ],
      "settings": { "foreground": "#4ea8de", "fontStyle": "bold" }
    },
    {
      "name": "Function / Method calls",
      "scope": [
        "meta.function-call",
        "meta.function-call entity.name.function",
        "variable.function",
        "support.function",
        "keyword.other.special-method",
        "entity.name.function.member",
        "meta.method-call meta.method"
      ],
      "settings": { "foreground": "#64c9ff" }
    },
    {
      "name": "Built-in / library functions",
      "scope": [
        "support.function.builtin",
        "support.function.magic",
        "support.function.construct"
      ],
      "settings": { "foreground": "#56e0c4" }
    },
    {
      "name": "Macros (Rust, C/C++)",
      "scope": ["entity.name.function.macro", "support.function.macro"],
      "settings": { "foreground": "#56e0c4", "fontStyle": "italic" }
    },
    {
      "name": "Constructors / new expressions",
      "scope": ["entity.name.function.constructor", "variable.function.constructor"],
      "settings": { "foreground": "#ffd166", "fontStyle": "bold" }
    },
    {
      "name": "Block Level Variables",
      "scope": ["meta.block variable.other"],
      "settings": { "foreground": "#f2e5e7" }
    },
    {
      "name": "Other Variable, String Link",
      "scope": ["support.other.variable", "string.other.link"],
      "settings": { "foreground": "#f2e5e7" }
    },
    {
      "name": "Number, Tag Attribute, Unit",
      "scope": [
        "constant.numeric",
        "support.constant",
        "constant.character",
        "constant.escape",
        "keyword.other.unit",
        "entity.other.attribute-name"
      ],
      "settings": { "foreground": "#ffb454" }
    },
    {
      "name": "String, Symbols, Inherited Class, Markup Heading",
      "scope": [
        "string",
        "constant.other.symbol",
        "constant.other.key",
        "entity.other.inherited-class",
        "markup.heading",
        "markup.inserted.git_gutter",
        "meta.group.braces.curly constant.other.object.key.js string.unquoted.label.js"
      ],
      "settings": { "foreground": "#a8e6a3" }
    },
    {
      "name": "Class, Interface, Struct, Enum names",
      "scope": [
        "entity.name.class",
        "entity.name.type.class",
        "entity.name.type.interface",
        "entity.name.type.struct",
        "entity.name.type.enum",
        "entity.name.type",
        "support.class",
        "support.orther.namespace.use.php",
        "meta.use.php",
        "support.other.namespace.php",
        "markup.changed.git_gutter",
        "support.type.sys-types"
      ],
      "settings": { "foreground": "#ffd166", "fontStyle": "bold" }
    },
    {
      "name": "Support / built-in types",
      "scope": ["support.type"],
      "settings": { "foreground": "#56e0c4" }
    },
    {
      "name": "Namespaces",
      "scope": ["entity.name.namespace", "entity.name.type.namespace"],
      "settings": { "foreground": "#ffd166", "fontStyle": "italic" }
    },
    {
      "name": "CSS Class and Support",
      "scope": [
        "source.css support.type.property-name",
        "source.sass support.type.property-name",
        "source.scss support.type.property-name",
        "source.less support.type.property-name",
        "source.stylus support.type.property-name",
        "source.postcss support.type.property-name"
      ],
      "settings": { "foreground": "#56e0c4" }
    },
    {
      "name": "Sub-methods",
      "scope": [
        "entity.name.module.js",
        "variable.import.parameter.js",
        "variable.other.class.js"
      ],
      "settings": { "foreground": "#f2e5e7" }
    },
    {
      "name": "this / self / cls",
      "scope": ["variable.language.this", "variable.language.self", "variable.parameter.function.language.special.self.python"],
      "settings": { "foreground": "#ff4d6d", "fontStyle": "italic bold" }
    },
    {
      "name": "Object keys, TypeScript grammar specific",
      "scope": ["meta.object-literal.key", "support.variable.property", "support.variable.property.dom"],
      "settings": { "foreground": "#ff8fa3" }
    },
    {
      "name": "CSS property value",
      "scope": [
        "support.constant.property-value",
        "support.constant.font-name",
        "support.constant.media-type",
        "support.constant.media",
        "constant.other.color.rgb-value",
        "constant.other.rgb-value",
        "support.constant.color"
      ],
      "settings": { "foreground": "#ffb454" }
    },
    {
      "name": "Regular Expressions",
      "scope": ["string.regexp"],
      "settings": { "foreground": "#56e0c4" }
    },
    {
      "name": "Escape Characters",
      "scope": ["constant.character.escape"],
      "settings": { "foreground": "#56e0c4" }
    },
    {
      "name": "URL",
      "scope": ["*url*", "*link*", "*uri*"],
      "settings": { "fontStyle": "underline" }
    },
    {
      "name": "Decorators / Annotations / Attributes",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator",
        "storage.type.annotation.java",
        "meta.attribute.rust",
        "meta.attribute.cs",
        "punctuation.definition.attribute.cs",
        "tag.decorator.js entity.name.tag.js",
        "tag.decorator.js punctuation.definition.tag.js"
      ],
      "settings": { "foreground": "#ffd166", "fontStyle": "italic" }
    },
    {
      "name": "JSON Key - Level 0",
      "scope": ["source.json meta.structure.dictionary.json support.type.property-name.json"],
      "settings": { "foreground": "#ff8fa3" }
    },
    {
      "name": "JSON Key - Level 1",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": { "foreground": "#ffb454" }
    },
    {
      "name": "Python function/class def",
      "scope": ["meta.function.python entity.name.function.python", "entity.name.class.python"],
      "settings": { "foreground": "#4ea8de", "fontStyle": "bold" }
    },
    {
